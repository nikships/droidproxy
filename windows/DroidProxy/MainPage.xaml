<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidProxy.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DroidProxy"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="DroidProxy" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StatusText" Text="Daemon offline" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="DetailText" TextWrapping="WrapWholeWords" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartStopButton" Content="Start Server" Click="OnStartStopClicked" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" TextWrapping="WrapWholeWords" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock Text="Providers" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ListView x:Name="ProviderList" SelectionMode="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
