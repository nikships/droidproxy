<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidProxy.AdvancedPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DroidProxy"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStackStyle}">
            <TextBlock Text="Advanced" Style="{StaticResource PageTitleStyle}" />
            <tk:SettingsCard Header="{x:Bind Vm.LaunchAtLogin.Label}" Description="Start DroidProxy in the tray when you sign in to Windows.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.LaunchAtLogin.IsOn, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{x:Bind Vm.SequentialFailover.Label}" Description="Use accounts in order and move to the next only when one runs out.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.SequentialFailover.IsOn, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{x:Bind Vm.VerboseLogging.Label}" Description="Write detailed request logs.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open logs" Click="{x:Bind Vm.OpenLogsFolder}" />
                    <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.VerboseLogging.IsOn, Mode=TwoWay}" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="{x:Bind Vm.RequestJournal.Label}" Description="Keep a journal of proxied requests.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE82D;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.RequestJournal.IsOn, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{x:Bind Vm.Beta.Label}" Description="Try features that are still in progress.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9CE;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.Beta.IsOn, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Auth folder" Description="Account credential files used by the proxy.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Open folder" Click="{x:Bind Vm.OpenAuthFolder}" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
