<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidProxy.NetworkPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DroidProxy"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStackStyle}">
            <TextBlock Text="Network &amp; remote" Style="{StaticResource PageTitleStyle}" />
            <InfoBar Margin="0,0,0,4" IsOpen="{x:Bind Vm.RemoteWithoutKey, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="No secret key" Message="Remote access is on without a secret key. Set one so only you can manage the proxy." />
            <tk:SettingsCard Header="{x:Bind Vm.AllowRemote.Label}" Description="Let other devices on your network use the proxy.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsOn="{x:Bind Vm.AllowRemote.IsOn, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Remote management secret key" Description="Required to manage the proxy from another device.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE192;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox Width="240" Password="{x:Bind Vm.SecretKeyDraft, Mode=TwoWay}" PasswordRevealMode="Peek"
                                 AutomationProperties.Name="Remote management secret key" />
                    <Button Content="Save" Click="{x:Bind Vm.SaveSecretKey}" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Bind address" Description="The interface the proxy listens on. Beta." Visibility="{x:Bind Vm.Beta.IsOn, Mode=OneWay}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" Text="{x:Bind Vm.BindAddressDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             AutomationProperties.Name="Bind address" />
                    <Button Content="Save" Click="{x:Bind Vm.SaveBindAddress}" />
                </StackPanel>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
